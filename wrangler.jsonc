// Deploys the built frontend (client/dist) with a minimal demo API worker.
// The worker auto-logs-in a fake user and serves canned replies so the site
// is usable without a real backend; the Node backend must still be hosted
// separately for real AI conversations.
{
  "name": "ungag-chat",
  "main": "worker/worker.js",
  "compatibility_date": "2026-09-22",
  "ai": { "binding": "AI" },
  "assets": {
    "binding": "ASSETS",
    "directory": "./client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
